# ============================================================================
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#   cp .env.example .env
# ============================================================================

# --- Groq (LLM provider used by the /api/chat route) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- GitHub (repo access / CI automation) ---
# https://github.com/settings/tokens  (scope: repo)
GITHUB_TOKEN=

# --- Vercel (CLI / headless CI deploys) ---
# https://vercel.com/account/tokens
VERCEL_TOKEN=